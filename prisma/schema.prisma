// HRIS AsiaCommerce — Prisma schema (PostgreSQL / Neon)
// Identitas & profil karyawan bersumber dari SSO (di-mirror ke Employee).
// HRIS memiliki data operasional HR: gaji, kuota cuti, pengajuan cuti & reimbursement.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Company {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  shareToken String? // token acak untuk link publik (demografi & data karyawan)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employees    Employee[]
  meetingRooms MeetingRoom[]

  @@index([shareToken])
  @@map("companies")
}

// Karyawan = orang terpadu + akun HRIS. Cermin dari SSO (user + profile).
model Employee {
  id        String  @id @default(cuid())
  ssoUserId String? // id user di SSO (sumber identitas)
  email     String  @unique
  name      String
  phone     String?

  // Cache profil dari SSO (untuk filter/ekspor tanpa call SSO tiap saat)
  employeeCode     String? // profile.employeeId di SSO
  jobTitle         String?
  level            String?
  departmentName   String?
  officeName       String?
  employmentStatus EmploymentStatus?
  gender           Gender?
  maritalStatus    MaritalStatus?
  joinDate         DateTime?
  nik              String?
  npwp             String?
  addressKtp       String?

  // Bisa diedit sendiri di HRIS (sync hanya isi bila kosong, tidak menimpa)
  birthDate         DateTime?
  emergencyName     String?
  emergencyRelation String?
  emergencyPhone    String?

  // Milik HRIS (tidak ditimpa saat sync)
  monthlySalary      Int? // gaji pokok bulanan (IDR)
  leaveQuota         Int       @default(12) // jatah cuti tahunan (hari)
  leaveAdjustment    Int       @default(0) // penyesuaian manual sisa cuti oleh HR
  role               String    @default("EMPLOYEE") // HR_ADMIN | HR_STAFF | EMPLOYEE
  isActive           Boolean   @default(true)
  photoDataUrl       String? // foto profil (data URL base64, diperkecil)
  onboardingClaimedAt DateTime?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leaveRequests         LeaveRequest[]        @relation("EmployeeLeaves")
  reviewedLeaves        LeaveRequest[]        @relation("LeaveReviewer")
  substituteForLeaves   LeaveRequest[]        @relation("LeaveSubstitute")
  managerForLeaves      LeaveRequest[]        @relation("LeaveManager")
  meetingBookings       MeetingBooking[]      @relation("EmployeeBookings")
  reimbursements        ReimbursementRequest[] @relation("EmployeeReimbursements")
  reviewedReimbursements ReimbursementRequest[] @relation("ReimbursementReviewer")
  pointEntries          PointEntry[]
  kudosSent             Kudos[]               @relation("KudosSender")
  kudosReceived         Kudos[]               @relation("KudosRecipient")
  kudosLikes            KudosLike[]
  kudosComments         KudosComment[]

  @@index([companyId])
  @@index([ssoUserId])
  @@map("employees")
}

// Ledger poin (sumber Activity Feed & total poin tahun berjalan).
model PointEntry {
  id         String    @id @default(cuid())
  employeeId String
  type       PointType
  amount     Int
  note       String?
  createdAt  DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, createdAt])
  @@map("point_entries")
}

model Kudos {
  id          String   @id @default(cuid())
  senderId    String
  recipientId String
  message     String
  createdAt   DateTime @default(now())

  sender    Employee       @relation("KudosSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient Employee       @relation("KudosRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  likes     KudosLike[]
  comments  KudosComment[]

  @@index([createdAt])
  @@index([senderId, createdAt])
  @@map("kudos")
}

model KudosLike {
  id         String   @id @default(cuid())
  kudosId    String
  employeeId String
  createdAt  DateTime @default(now())

  kudos    Kudos    @relation(fields: [kudosId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([kudosId, employeeId])
  @@map("kudos_likes")
}

model KudosComment {
  id         String   @id @default(cuid())
  kudosId    String
  employeeId String
  message    String
  createdAt  DateTime @default(now())

  kudos    Kudos    @relation(fields: [kudosId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([kudosId, createdAt])
  @@map("kudos_comments")
}

enum PointType {
  KUDOS_SENT
  KUDOS_RECEIVED
  DAILY_CHECKIN
  ONBOARDING
}

model LeaveRequest {
  id         String        @id @default(cuid())
  employeeId String
  type       LeaveType     @default(ANNUAL)
  startDate  DateTime
  endDate    DateTime
  days       Int
  reason     String?
  task       String? // tugas/hand-over selama cuti (opsional)
  status     RequestStatus @default(PENDING)

  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?

  // Karyawan pengganti & Manager/Lead (dikonfirmasi lewat kode OTP masing-masing)
  substituteId String?
  managerId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee   Employee  @relation("EmployeeLeaves", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer   Employee? @relation("LeaveReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  substitute Employee? @relation("LeaveSubstitute", fields: [substituteId], references: [id], onDelete: SetNull)
  manager    Employee? @relation("LeaveManager", fields: [managerId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([status])
  @@map("leave_requests")
}

// Kode OTP konfirmasi karyawan pengganti untuk pengajuan cuti.
model SubstituteOtp {
  id           String    @id @default(cuid())
  requesterId  String // Employee yang mengajukan cuti
  substituteId String // Employee pengganti (penerima kode)
  code         String // 6 digit
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([requesterId, substituteId])
  @@map("substitute_otps")
}

model ReimbursementRequest {
  id          String        @id @default(cuid())
  employeeId  String
  category    String
  title       String
  amount      Int
  spentAt     DateTime
  description String?
  status      RequestStatus @default(PENDING)

  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee  @relation("EmployeeReimbursements", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer Employee? @relation("ReimbursementReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([status])
  @@map("reimbursement_requests")
}

// Ruang rapat (seed tetap: UTAMA & SERVER)
model MeetingRoom {
  id        String   @id @default(cuid())
  key       String // "UTAMA" | "SERVER"
  name      String
  isActive  Boolean  @default(true)
  companyId String
  createdAt DateTime @default(now())

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bookings MeetingBooking[]

  @@unique([key, companyId])
  @@index([companyId])
  @@map("meeting_rooms")
}

model MeetingBooking {
  id          String        @id @default(cuid())
  roomId      String
  employeeId  String
  title       String
  department  String?
  startAt     DateTime
  endAt       DateTime
  status      BookingStatus @default(BOOKED)
  checkedInAt DateTime?
  reminderSentAt DateTime? // waktu pengingat WA 5 menit sebelum meeting dikirim
  seriesId    String? // grup untuk meeting berulang (recurring)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  room     MeetingRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  employee Employee    @relation("EmployeeBookings", fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([roomId, startAt])
  @@index([startAt])
  @@index([seriesId])
  @@map("meeting_bookings")
}

enum BookingStatus {
  BOOKED
  CHECKED_IN
  AUTO_CHECKED_IN
  RELEASED
  CANCELLED
}

enum LeaveType {
  ANNUAL
  SICK
  SICK_CERTIFIED
  UNPAID
  OTHER
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Gender {
  MALE
  FEMALE
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum EmploymentStatus {
  PERMANENT
  CONTRACT
  INTERNSHIP
  FREELANCE
}
